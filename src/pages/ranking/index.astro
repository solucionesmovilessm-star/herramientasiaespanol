---
import RankingTable from '../../components/RankingTable.astro';
import rankingFile from '../../data/ranking.json';
import trendingFile from '../../data/trending-2026-11-25.json';
import Base from '../../layouts/Base.astro';
import { breadcrumbLd, canonicalUrl, formatDate, formatNumber, itemListLd } from '../../lib/seo';

const generated = rankingFile.generatedAt ? new Date(rankingFile.generatedAt) : null;
const trendingTaken = new Date(trendingFile.takenAt);
const pageUrl = canonicalUrl('/ranking');
const description =
  'Top 10 de repositorios de IA en GitHub Trending del 25 de noviembre de 2026, con estrellas y estrellas de hoy. Debajo, el ranking semanal de la API, que no es el Trending oficial.';
---

<Base
  title="Ranking de repos de IA"
  description={description}
  jsonLd={[
    breadcrumbLd([
      { name: 'Inicio', url: canonicalUrl('/') },
      { name: 'Ranking', url: pageUrl },
    ]),
    itemListLd(
      'GitHub Trending de IA del 25 de noviembre de 2026',
      trendingFile.repos.map((repo) => ({ name: repo.fullName, url: repo.url })),
    ),
    itemListLd(
      'Repos de IA en movimiento',
      rankingFile.enMovimiento.map((repo) => ({ name: repo.fullName, url: repo.url })),
    ),
  ]}
>
  <div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">GitHub</p>
      <h1>Ranking de repos de IA</h1>
      <p class="lede">{description}</p>
    </header>

    <section class="section" aria-labelledby="github-trending">
      <h2 id="github-trending">GitHub Trending del 25 de noviembre de 2026</h2>
      <p class="fine">{trendingFile.note}</p>
      <p class="meta">
        Datos del <time datetime={trendingTaken.toISOString()}>{formatDate(trendingTaken)}</time>.
      </p>
      <div class="table-wrap">
        <table class="rank">
          <caption class="sr-only">Top 10 de repositorios de IA en GitHub Trending del 25 de noviembre de 2026</caption>
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Repositorio</th>
              <th scope="col">Estrellas</th>
              <th scope="col">Estrellas hoy</th>
            </tr>
          </thead>
          <tbody>
            {
              trendingFile.repos.map((repo) => (
                <tr>
                  <td>{repo.rank}</td>
                  <td>
                    <a href={repo.url} rel="noopener noreferrer">
                      {repo.fullName}
                    </a>
                    <div class="meta">{repo.description}</div>
                  </td>
                  <td>{formatNumber(repo.stars)}</td>
                  <td>+{formatNumber(repo.starsToday)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <header class="page-intro">
      <h2>Ranking semanal</h2>
      <p class="fine">{rankingFile.note}</p>
      {
        generated && (
          <p class="meta">
            Datos del <time datetime={generated.toISOString()}>{formatDate(generated)}</time>. Ventana de actividad: desde el{' '}
            {rankingFile.windowStart}.
          </p>
        )
      }
    </header>

    <section class="section" aria-labelledby="en-movimiento">
      <h2 id="en-movimiento">En movimiento</h2>
      <RankingTable repos={rankingFile.enMovimiento} caption="Repositorios de IA con actividad reciente, ordenados por estrellas" />
    </section>

    <section class="section" aria-labelledby="mas-estrellados">
      <h2 id="mas-estrellados">Más estrellados</h2>
      <RankingTable repos={rankingFile.masEstrellados} caption="Repositorios de IA con más estrellas" />
    </section>

    <p class="fine">
      En el ranking semanal, si hay una descripción en español se muestra esa; si no, la del repositorio.
      Ese archivo vive en <code>src/data/ranking.json</code> y lo reescribe el workflow cada lunes.
      El top de Trending está aparte, en <code>src/data/trending-2026-11-25.json</code>, para que el lunes no lo borre.
    </p>
  </div>
</Base>
