---
import StaticForm from '../components/StaticForm.astro';
import Base from '../layouts/Base.astro';
import { getAdOptions } from '../lib/sponsors';
import { breadcrumbLd, canonicalUrl } from '../lib/seo';
import { SITE_URL, contactHref, contactTodo } from '../lib/site';

const description =
  'Anúnciate en Herramientas IA: ficha patrocinada, enlace de afiliado, hueco en la newsletter o mención en shorts. Sin pasarela de pago todavía.';
const pageUrl = canonicalUrl('/anunciate');
const options = getAdOptions();
---

<Base
  title="Anúnciate"
  description={description}
  jsonLd={breadcrumbLd([
    { name: 'Inicio', url: SITE_URL },
    { name: 'Anúnciate', url: pageUrl },
  ])}
>
  <article class="narrow">
    <header class="page-intro">
      <p class="eyebrow">Colaboraciones</p>
      <h1>Anúnciate o destaca tu herramienta</h1>
      <p class="lede">
        La mayor parte del sitio sigue siendo gratis y editorial. Si hay dinero de por medio, se ve. No hay tienda ni
        pago con tarjeta en esta versión.
      </p>
    </header>
    <div class="prose">
      {
        options.map((option) => (
          <section>
            <h2>{option.titulo}</h2>
            <p>{option.texto}</p>
            <p class="meta">{option.como}</p>
          </section>
        ))
      }
      <h2>Cómo pedir un hueco</h2>
      <p>
        Escribe a <a href={contactHref}>contacto</a>. <strong>{contactTodo}</strong>. Cuenta el nombre de la herramienta,
        la URL oficial, la opción que te interesa y si quieres un enlace de afiliado. El precio de cada formato se acuerda
        aparte: esta página no inventa tarifas.
      </p>
      <p>
        El formulario de abajo no envía el mensaje. Sirve para dejar el hueco visual hasta que haya un buzón conectado.
      </p>
    </div>
    <StaticForm
      submitLabel="Preparar el aviso"
      message="Este formulario no envía nada. Tu correo no se ha guardado. Cuando el enlace de contacto deje de ser TODO, escribe por ahí."
    />
  </article>
</Base>
