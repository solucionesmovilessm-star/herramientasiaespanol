---
import Card from '../../components/Card.astro';
import Base from '../../layouts/Base.astro';
import { priceCheckLabel } from '../../lib/catalog';
import { loadPublished, moneyBadges } from '../../lib/content';
import { breadcrumbLd, canonicalUrl } from '../../lib/seo';
import { pricingLabel, SITE_URL } from '../../lib/site';

const items = (await loadPublished('herramientas')).filter((entry) => entry.data.category === 'grok');
const title = 'Grok';
const description =
  'Sección para fichas de Grok y de xAI. Solo aparece lo que está publicado en el directorio. No hay una lista de vídeos ni datos de precio que la ficha no tenga.';
const pageUrl = canonicalUrl('/grok');
---

<Base
  title={title}
  description={description}
  jsonLd={breadcrumbLd([
    { name: 'Inicio', url: SITE_URL },
    { name: title, url: pageUrl },
  ])}
>
  <div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">Sección</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p><a class="text-link" href="/herramientas?categoria=grok">Ver el filtro de esta tarea</a></p>
    </header>
    {
      items.length === 0 ? (
        <p>Todavía no hay fichas en la categoría Grok.</p>
      ) : (
        <div class="grid">
          {items.map((entry) => (
            <Card
              href={`/herramientas/${entry.id}`}
              title={entry.data.title}
              description={entry.data.description}
              meta="Grok"
              badges={moneyBadges({ ...entry.data, pricingLabels: pricingLabel })}
              priceNote={priceCheckLabel(entry.data.precioVerificado)}
            />
          ))}
        </div>
      )
    }
  </div>
</Base>
