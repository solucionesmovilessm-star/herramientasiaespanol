---
import EditorialList from '../../components/EditorialList.astro';
import Base from '../../layouts/Base.astro';
import { editorialOrder } from '../../lib/catalog';
import { loadPublished } from '../../lib/content';
import { breadcrumbLd, canonicalUrl } from '../../lib/seo';
import { categories, SITE_URL } from '../../lib/site';

export function getStaticPaths() {
  return Object.keys(categories).map((categoria) => ({ params: { categoria } }));
}

const { categoria } = Astro.params;
const key = categoria as keyof typeof categories;
const label = categories[key];
const items = editorialOrder((await loadPublished('herramientas')).filter((entry) => entry.data.category === key));
const title = label;
const description = `Fichas de ${label}. El orden es Destacado y después el nombre, no una nota.`;
const pageUrl = canonicalUrl(`/mejores/${key}`);
---

<Base
  title={title}
  description={description}
  jsonLd={breadcrumbLd([
    { name: 'Inicio', url: SITE_URL },
    { name: 'Mejores', url: `${SITE_URL}/mejores` },
    { name: title, url: pageUrl },
  ])}
>
  <div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">Por tarea</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p>
        <a class="text-link" href={`/herramientas?categoria=${key}`}>Filtrar esta tarea en el directorio</a>
      </p>
    </header>
    <EditorialList
      empty="No hay fichas en esta tarea."
      items={items.map((entry) => ({
        href: `/herramientas/${entry.id}`,
        title: entry.data.title,
        description: entry.data.description,
        meta: `${entry.data.destacado ? 'Destacado · ' : ''}${entry.data.pricing}`,
      }))}
    />
  </div>
</Base>
