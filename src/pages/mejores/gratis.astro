---
import EditorialList from '../../components/EditorialList.astro';
import Base from '../../layouts/Base.astro';
import { editorialOrder } from '../../lib/catalog';
import { loadPublished } from '../../lib/content';
import { breadcrumbLd, canonicalUrl } from '../../lib/seo';
import { categories, SITE_URL } from '../../lib/site';

const items = editorialOrder((await loadPublished('herramientas')).filter((entry) => entry.data.pricing === 'gratis'));
const title = 'Mejores gratis';
const description =
  'Fichas con precio gratis. El orden pone primero Destacado y luego el nombre. No es una puntuación. Freemium y créditos gratis no entran aquí.';
const pageUrl = canonicalUrl('/mejores/gratis');
---

<Base
  title={title}
  description={description}
  jsonLd={breadcrumbLd([
    { name: 'Inicio', url: SITE_URL },
    { name: 'Mejores', url: `${SITE_URL}/mejores` },
    { name: title, url: pageUrl },
  ])}
>
  <div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">Precio gratis</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p><a class="text-link" href="/criterio">Cómo se ordena</a></p>
    </header>
    <EditorialList
      empty="No hay fichas con precio gratis."
      items={items.map((entry) => ({
        href: `/herramientas/${entry.id}`,
        title: entry.data.title,
        description: entry.data.description,
        meta: `${categories[entry.data.category]}${entry.data.destacado ? ' · Destacado' : ''}`,
      }))}
    />
  </div>
</Base>
