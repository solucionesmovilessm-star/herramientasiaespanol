---
import EditorialList from '../../components/EditorialList.astro';
import Base from '../../layouts/Base.astro';
import { editorialOrder } from '../../lib/catalog';
import { loadPublished } from '../../lib/content';
import { breadcrumbLd, canonicalUrl } from '../../lib/seo';
import { categories, SITE_URL } from '../../lib/site';

const items = editorialOrder(
  (await loadPublished('herramientas')).filter((entry) => entry.data.interfazEspanol === true),
);
const title = 'Mejores en español';
const description =
  'Solo entran herramientas cuya interfaz en español está marcada en la ficha. Que esta web esté en español no basta, y hoy ninguna ficha lo tiene comprobado.';
const pageUrl = canonicalUrl('/mejores/en-espanol');
---

<Base
  title={title}
  description={description}
  jsonLd={breadcrumbLd([
    { name: 'Inicio', url: SITE_URL },
    { name: 'Mejores', url: `${SITE_URL}/mejores` },
    { name: title, url: pageUrl },
  ])}
>
  <div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">Interfaz comprobada</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p><a class="text-link" href="/criterio">Ver el criterio</a></p>
    </header>
    <EditorialList
      empty="Ninguna ficha tiene la interfaz en español comprobada. No rellenamos esa lista con suposiciones."
      items={items.map((entry) => ({
        href: `/herramientas/${entry.id}`,
        title: entry.data.title,
        description: entry.data.description,
        meta: categories[entry.data.category],
      }))}
    />
  </div>
</Base>
