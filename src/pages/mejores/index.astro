---
import Base from '../../layouts/Base.astro';
import { editorialOrder } from '../../lib/catalog';
import { loadPublished } from '../../lib/content';
import { breadcrumbLd, canonicalUrl } from '../../lib/seo';
import { categories, SITE_URL } from '../../lib/site';

const tools = await loadPublished('herramientas');
const gratis = tools.filter((entry) => entry.data.pricing === 'gratis');
const enEspanol = tools.filter((entry) => entry.data.interfazEspanol === true);
const title = 'Listados por tarea';
const description =
  'Listados del directorio. El orden es Destacado y después el nombre. No es una nota del 1 al 5: el criterio público está en la página Criterio y todavía no puntúa fichas.';
const pageUrl = canonicalUrl('/mejores');
---

<Base
  title="Mejores herramientas"
  description={description}
  jsonLd={breadcrumbLd([
    { name: 'Inicio', url: SITE_URL },
    { name: 'Mejores', url: pageUrl },
  ])}
>
  <div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">Sin nota numérica</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p><a class="text-link" href="/criterio">Ver el criterio editorial</a></p>
    </header>
    <div class="grid">
      <a class="card" href="/mejores/gratis">
        <h2>Mejores gratis</h2>
        <p>{gratis.length} {gratis.length === 1 ? 'ficha' : 'fichas'} con precio gratis. No incluye freemium ni créditos sin verificar.</p>
      </a>
      <a class="card" href="/mejores/en-espanol">
        <h2>Mejores en español</h2>
        <p>
          {enEspanol.length === 0
            ? 'Ninguna ficha tiene la interfaz en español comprobada. El idioma de esta web no cuenta como dato del producto.'
            : `${enEspanol.length} fichas con la interfaz en español comprobada.`}
        </p>
      </a>
      {
        editorialOrder(
          Object.entries(categories).map(([id, label]) => ({
            id,
            label,
            data: { title: label, destacado: false },
            count: tools.filter((entry) => entry.data.category === id).length,
          })),
        )
          .sort((a, b) => a.label.localeCompare(b.label, 'es'))
          .map((category) => (
            <a class="card" href={`/mejores/${category.id}`}>
              <h2>{category.label}</h2>
              <p>{category.count} {category.count === 1 ? 'ficha' : 'fichas'} en esta tarea.</p>
            </a>
          ))
      }
    </div>
  </div>
</Base>
