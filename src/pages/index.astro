---
import Card from '../components/Card.astro';
import ChannelBoard from '../components/ChannelBoard.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import SponsorSlot from '../components/SponsorSlot.astro';
import StaticForm from '../components/StaticForm.astro';
import rankingFile from '../data/ranking.json';
import { moneyBadges, loadPublished } from '../lib/content';
import { formatNumber, itemListLd, websiteLd } from '../lib/seo';
import { SITE_NAME, categories, pricingLabel } from '../lib/site';
import Base from '../layouts/Base.astro';

const tools = await loadPublished('herramientas');
const agents = await loadPublished('agentes');
const skills = await loadPublished('skills');
const servers = await loadPublished('mcp');
const guides = await loadPublished('guias');
const tutorials = await loadPublished('tutoriales');
const claudeSkills = skills.filter((entry) => entry.data.category === 'claude');
const featured = tools.filter((entry) => entry.data.destacado && !entry.data.patrocinado);
const sponsored = tools.filter((entry) => entry.data.patrocinado);
const spotlightIds = ['chatgpt', 'claude', 'perplexity'];
const spotlight = spotlightIds
  .map((id) => tools.find((entry) => entry.id === id))
  .filter((entry) => entry !== undefined);
const tasks = ['escribir', 'dibujar', 'programar', 'investigar', 'traducir', 'automatizar'];

const description =
  'Directorio en español de herramientas de IA, agentes, skills y servidores MCP. Enlaces oficiales, guías y un ranking semanal con datos de GitHub.';

const categoryCounts = Object.entries(categories).map(([id, label]) => ({
  id,
  label,
  count: tools.filter((entry) => entry.data.category === id).length,
}));

const ranking = rankingFile.enMovimiento.slice(0, 5);
const jsonLd = [
  websiteLd(description),
  itemListLd(
    'Herramientas de IA',
    tools.map((entry) => ({
      name: entry.data.title,
      url: `https://herramientasiaespanol.com/herramientas/${entry.id}`,
    })),
  ),
];
---

<Base title={SITE_NAME} description={description} jsonLd={jsonLd}>
  <section class="hero-band">
    <div class="aurora" aria-hidden="true">
      <span class="orb orb-a"></span>
      <span class="orb orb-b"></span>
      <span class="orb orb-c"></span>
      <span class="hero-grid"></span>
    </div>
    <div class="wrap hero">
      <div class="hero-copy">
        <p class="eyebrow">Directorio en español</p>
        <h1>
          La IA que necesitas para
          <span class="swap" aria-hidden="true">
            <span class="swap-track">
              {tasks.map((task) => <span>{task}</span>)}
              <span>{tasks[0]}</span>
            </span>
          </span>
          <span class="sr-only">escribir, dibujar, programar, investigar, traducir o automatizar</span>
        </h1>
        <p class="lede">
          Chats, imagen, vídeo, código, agentes, skills y servidores MCP, con el enlace oficial al lado.
          Casi todo es gratis de leer. Lo que es un anuncio lleva la etiqueta Patrocinado.
        </p>
        <form class="cmd-search" action="/herramientas" method="get" role="search">
          <label class="sr-only" for="hero-q">Buscar una herramienta</label>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <circle cx="11" cy="11" r="6"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <input
            id="hero-q"
            name="q"
            type="search"
            placeholder="Busca por tarea o nombre"
            data-typed-placeholder="escribir un texto|generar una imagen|editar un vídeo|programar|investigar con fuentes|un servidor MCP"
            autocomplete="off"
            enterkeyhint="search"
          />
          <button class="button" type="submit">Buscar</button>
        </form>
        <p class="hero-kbd">
          <button class="text-btn" type="button" data-cmdk-open>
            Abrir el buscador
            <kbd>Ctrl</kbd>
            <kbd>K</kbd>
          </button>
        </p>
        <div class="hero-actions">
          <a class="button" href="/herramientas">Ver herramientas</a>
          <a class="button secondary" href="/tutoriales">Tutoriales para novatos</a>
        </div>
        <ul class="stats">
          <li>
            <strong data-count={tools.length}>{tools.length}</strong>
            <span>herramientas</span>
          </li>
          <li>
            <strong data-count={agents.length}>{agents.length}</strong>
            <span>agentes</span>
          </li>
          <li>
            <strong data-count={skills.length}>{skills.length}</strong>
            <span>skills</span>
          </li>
          <li>
            <strong data-count={servers.length}>{servers.length}</strong>
            <span>servidores MCP</span>
          </li>
        </ul>
      </div>
      <div class="hero-stage" aria-label="Tres fichas para empezar">
        {
          spotlight.map((entry) => (
            <a class="stage-card" href={`/herramientas/${entry.id}`}>
              <Mark name={entry.data.title} />
              <span>
                <small>{categories[entry.data.category]}</small>
                <strong>{entry.data.title}</strong>
                <span>{entry.data.description}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="wrap home">
    <nav class="chips" aria-label="Por tarea">
      {
        categoryCounts.map((category) => (
          <a class="chip" href={`/herramientas?categoria=${category.id}`}>
            <Icon name={category.id} />
            <span>{category.label}</span>
            <span class="chip-count">{category.count}</span>
          </a>
        ))
      }
    </nav>

    <div class="bento">
      <section class="glass bento-featured" data-reveal aria-labelledby="destacados">
        <div class="section-head">
          <div>
            <p class="kicker">Selección editorial</p>
            <h2 id="destacados">Herramientas destacadas</h2>
          </div>
          <a href="/herramientas">Ver todas</a>
        </div>
        <p class="fine">Destacado significa que lo hemos elegido para empezar. No es un anuncio ni un ranking de laboratorio.</p>
        <div class="stack">
          {
            featured.map((entry) => (
              <a class="row-link" href={`/herramientas/${entry.id}`}>
                <Mark name={entry.data.title} />
                <span class="row-copy">
                  <strong>{entry.data.title}</strong>
                  <span>{categories[entry.data.category]}</span>
                </span>
                <span class="badge-row">
                  {moneyBadges({ ...entry.data, pricingLabels: pricingLabel }).map((badge) => (
                    <span class:list={['badge', badge.tone]}>{badge.label}</span>
                  ))}
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="glass bento-ranking" data-reveal aria-labelledby="ranking">
        <div class="section-head">
          <div>
            <p class="kicker">GitHub</p>
            <h2 id="ranking">Ranking de repos</h2>
          </div>
          <a href="/ranking">Ver el ranking</a>
        </div>
        <p class="fine">Estrellas reales de la API de GitHub. No es el Trending oficial.</p>
        {
          ranking.length > 0 ? (
            <ol class="rank-list">
              {ranking.map((repo) => (
                <li>
                  <a href={repo.url} rel="noopener noreferrer">
                    <span class="rank-n">{repo.rank}</span>
                    <span>
                      <strong>{repo.fullName}</strong>
                      <span class="meta">{repo.language ?? '—'}</span>
                    </span>
                    <span class="stars">{formatNumber(repo.stars)}</span>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p>El ranking se rellena con la acción semanal de GitHub.</p>
          )
        }
      </section>

      <section class="glass" data-reveal aria-labelledby="skills-claude">
        <p class="kicker">Agent Skills</p>
        <h2 id="skills-claude">Skills de Claude</h2>
        <p class="stat-xl"><span data-count={claudeSkills.length}>{claudeSkills.length}</span></p>
        <p class="fine">Fichas enlazadas, no recopiladas.</p>
        <ul class="list-plain">
          {
            claudeSkills.slice(0, 4).map((entry) => (
              <li>
                <a href={`/skills/${entry.id}`}>{entry.data.title}</a>
              </li>
            ))
          }
        </ul>
        <p><a class="text-link" href="/skills/claude">Ver skills para Claude</a></p>
      </section>

      <section class="glass" data-reveal aria-labelledby="mcp">
        <p class="kicker">Protocolo</p>
        <h2 id="mcp">MCP</h2>
        <p class="stat-xl"><span data-count={servers.length}>{servers.length}</span></p>
        <p class="fine">Servidores con ficha y enlace oficial.</p>
        <ul class="list-plain">
          {
            servers.slice(0, 4).map((entry) => (
              <li>
                <a href={`/mcp/${entry.id}`}>{entry.data.title}</a>
              </li>
            ))
          }
        </ul>
        <p><a class="text-link" href="/mcp">Ver servidores MCP</a></p>
      </section>

      <section class="glass" data-reveal aria-labelledby="aprende">
        <p class="kicker">Para empezar</p>
        <h2 id="aprende">Tutoriales</h2>
        <p class="stat-xl"><span data-count={tutorials.length}>{tutorials.length}</span></p>
        <p class="fine">Paso a paso, nivel novato.</p>
        <ul class="list-plain">
          {
            tutorials.map((entry) => (
              <li>
                <a href={`/tutoriales/${entry.id}`}>{entry.data.title}</a>
                <span class="meta"> · {entry.data.minutes} min</span>
              </li>
            ))
          }
        </ul>
        <p><a class="text-link" href="/tutoriales">Ver los tutoriales</a></p>
      </section>
    </div>

    {
      sponsored.length > 0 && (
        <section class="section" aria-labelledby="patrocinados">
          <div class="section-head">
            <h2 id="patrocinados">Patrocinados</h2>
            <a href="/anunciate">Anúnciate</a>
          </div>
          <div class="grid">
            {sponsored.map((entry) => (
              <Card
                heading="h3"
                href={`/herramientas/${entry.id}`}
                title={entry.data.title}
                description={entry.data.description}
                meta={categories[entry.data.category]}
                badges={moneyBadges({ ...entry.data, pricingLabels: pricingLabel })}
              />
            ))}
          </div>
        </section>
      )
    }

    <section class="section" aria-labelledby="guias">
      <div class="section-head">
        <h2 id="guias">Guías</h2>
        <a href="/guias">Todas las guías</a>
      </div>
      <div class="grid">
        {
          guides.map((entry) => (
            <Card
              heading="h3"
              href={`/guias/${entry.id}`}
              title={entry.data.title}
              description={entry.data.description}
            />
          ))
        }
      </div>
    </section>

    <section class="section split" aria-labelledby="newsletter">
      <div class="glass panel-pad">
        <h2 id="newsletter">Newsletter</h2>
        <p class="lede">
          Un aviso cuando haya una guía nueva o cambie el ranking. El formulario todavía no envía el correo a ningún
          servicio: es el hueco listo para conectarlo sin coste.
        </p>
        <StaticForm
          submitLabel="Quiero que me avisen"
          message="Todavía no hay un servicio de newsletter conectado. Tu correo no se ha enviado a ningún sitio y no se ha guardado."
        />
      </div>
      <SponsorSlot id="newsletter" />
    </section>

    <ChannelBoard />
    <div class="section">
      <SponsorSlot id="shorts" />
    </div>
  </div>
</Base>
