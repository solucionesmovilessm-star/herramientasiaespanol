---
import Directory from '../../components/Directory.astro';
import { loadPublished, matchesQuery, moneyBadges } from '../../lib/content';
import { breadcrumbLd, canonicalUrl, itemListLd } from '../../lib/seo';
import { categories, pricingLabel, SITE_URL } from '../../lib/site';

const all = await loadPublished('herramientas');
const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const categoria = Astro.url.searchParams.get('categoria') ?? '';
const active = categoria in categories ? categoria : '';
const filtered = all.filter((entry) => {
  if (active && entry.data.category !== active) return false;
  return matchesQuery(
    [entry.data.title, entry.data.description, entry.data.tags.join(' '), categories[entry.data.category]],
    q,
  );
});

const title = 'Herramientas de IA por tarea';
const lede =
  'Un directorio para elegir por lo que quieres hacer: escribir, dibujar, editar vídeo, programar o traducir. Cada ficha enlaza la web oficial.';
const filters = [
  {
    id: 'todas',
    label: 'Todas',
    href: q ? `/herramientas?q=${encodeURIComponent(q)}` : '/herramientas',
    current: !active,
  },
  ...Object.entries(categories).map(([id, label]) => ({
    id,
    label,
    href: `/herramientas?categoria=${id}${q ? `&q=${encodeURIComponent(q)}` : ''}`,
    current: active === id,
  })),
];
const hasFilter = Boolean(q || active);
const pageUrl = canonicalUrl('/herramientas');
const jsonLd = hasFilter
  ? undefined
  : [
      breadcrumbLd([
        { name: 'Inicio', url: SITE_URL },
        { name: title, url: pageUrl },
      ]),
      itemListLd(
        title,
        all.map((entry) => ({
          name: entry.data.title,
          url: `${SITE_URL}/herramientas/${entry.id}`,
        })),
      ),
    ];
---

<Directory
  title={title}
  eyebrow="Directorio"
  lede={lede}
  metaDescription="Herramientas de IA ordenadas por tarea, con enlace oficial, precio orientativo y la etiqueta Patrocinado cuando hay un acuerdo."
  items={filtered.map((entry) => ({
    href: `/herramientas/${entry.id}`,
    title: entry.data.title,
    description: entry.data.description,
    meta: categories[entry.data.category],
    badges: moneyBadges({ ...entry.data, pricingLabels: pricingLabel }),
  }))}
  filters={filters}
  query={q}
  searchAction="/herramientas"
  hiddenFields={active ? [{ name: 'categoria', value: active }] : []}
  jsonLd={jsonLd}
/>
