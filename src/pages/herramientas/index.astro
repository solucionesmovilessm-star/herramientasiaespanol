---
import ToolBrowser from '../../components/ToolBrowser.astro';
import { loadPublished, moneyBadges } from '../../lib/content';
import { priceCheckLabel } from '../../lib/catalog';
import { breadcrumbLd, canonicalUrl, itemListLd } from '../../lib/seo';
import { categories, pricingLabel, SITE_URL } from '../../lib/site';

const all = await loadPublished('herramientas');
const tutorials = await loadPublished('tutoriales');
const tutorialTitle = new Map(tutorials.map((entry) => [entry.id, entry.data.title]));
const ordered = [...all].sort((a, b) => {
  const ad = Number(b.data.patrocinado) - Number(a.data.patrocinado);
  if (ad !== 0) return ad;
  return a.data.title.localeCompare(b.data.title, 'es');
});

const title = 'Herramientas de IA por tarea';
const lede =
  'Busca por nombre y combina la tarea con el precio. «Con créditos gratis» solo marca fichas donde ese dato está escrito. Hoy no hay ninguna.';
const pageUrl = canonicalUrl('/herramientas');
const jsonLd = [
  breadcrumbLd([
    { name: 'Inicio', url: SITE_URL },
    { name: title, url: pageUrl },
  ]),
  itemListLd(
    title,
    all.map((entry) => ({
      name: entry.data.title,
      url: `${SITE_URL}/herramientas/${entry.id}`,
    })),
  ),
];
---

<ToolBrowser
  title={title}
  lede={lede}
  description="Herramientas de IA ordenadas por tarea, con enlace oficial, precio orientativo y la etiqueta Patrocinado o Anuncio cuando hay un acuerdo."
  jsonLd={jsonLd}
  items={ordered.map((entry) => {
    const tutorial = entry.data.tutorial;
    const linked = tutorial && tutorialTitle.has(tutorial) ? tutorial : undefined;
    return {
      href: `/herramientas/${entry.id}`,
      title: entry.data.title,
      description: entry.data.description,
      category: entry.data.category,
      pricing: entry.data.pricing,
      credits: entry.data.creditosGratis === true,
      sponsored: entry.data.patrocinado === true,
      search: [
        entry.data.title,
        entry.data.description,
        entry.data.tags.join(' '),
        categories[entry.data.category],
        ...(entry.data.pros ?? []),
        ...(entry.data.contras ?? []),
      ].join(' '),
      badges: moneyBadges({ ...entry.data, pricingLabels: pricingLabel }),
      priceNote: priceCheckLabel(entry.data.precioVerificado),
      tutorialHref: linked ? `/tutoriales/${linked}` : undefined,
      tutorialTitle: linked ? tutorialTitle.get(linked) : undefined,
    };
  })}
/>
