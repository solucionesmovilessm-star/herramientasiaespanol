---
import Directory from '../../components/Directory.astro';
import { loadPublished, matchesQuery, moneyBadges } from '../../lib/content';
import { breadcrumbLd, canonicalUrl, itemListLd, pagePath } from '../../lib/seo';
import { agentCategories, pricingLabel } from '../../lib/site';

const all = await loadPublished('agentes');
const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const categoria = Astro.url.searchParams.get('categoria') ?? '';
const active = categoria in agentCategories ? categoria : '';
const filtered = all.filter((entry) => {
  if (active && entry.data.category !== active) return false;
  return matchesQuery([entry.data.title, entry.data.description, agentCategories[entry.data.category]], q);
});
const title = 'Agentes y bots';
const lede =
  'Programas que no solo responden: pueden usar herramientas, seguir pasos o encadenar tareas. Cada ficha dice qué es y enlaza el sitio oficial.';
const pageUrl = canonicalUrl('/agentes');
const hasFilter = Boolean(q || active);
---

<Directory
  title={title}
  eyebrow="Directorio"
  lede={lede}
  metaDescription="Agentes y bots de IA explicados en español: frameworks, agentes de programación y herramientas de automatización, con enlace oficial."
  items={filtered.map((entry) => ({
    href: pagePath(`/agentes/${entry.id}`),
    title: entry.data.title,
    description: entry.data.description,
    meta: agentCategories[entry.data.category],
    badges: moneyBadges({ ...entry.data, pricingLabels: pricingLabel }),
  }))}
  filters={[
    {
      id: 'todas',
      label: 'Todas',
      href: q ? pagePath(`/agentes?q=${encodeURIComponent(q)}`) : pagePath('/agentes'),
      current: !active,
    },
    ...Object.entries(agentCategories).map(([id, label]) => ({
      id,
      label,
      href: pagePath(`/agentes?categoria=${id}${q ? `&q=${encodeURIComponent(q)}` : ''}`),
      current: active === id,
    })),
  ]}
  query={q}
  searchAction={pagePath('/agentes')}
  hiddenFields={active ? [{ name: 'categoria', value: active }] : []}
  jsonLd={hasFilter
    ? undefined
    : [
        breadcrumbLd([
          { name: 'Inicio', url: canonicalUrl('/') },
          { name: title, url: pageUrl },
        ]),
        itemListLd(
          title,
          all.map((entry) => ({ name: entry.data.title, url: canonicalUrl(`/agentes/${entry.id}`) })),
        ),
      ]}
/>
