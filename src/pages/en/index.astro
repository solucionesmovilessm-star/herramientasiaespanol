---
import Base from '../../layouts/Base.astro';

const description =
  'The English version of this Spanish AI directory is not published yet. The live site is in Spanish.';
---

<Base title="English, coming soon" description={description} noindex>
  <div class="wrap page-intro">
    <p class="eyebrow">English</p>
    <h1>This version is not ready</h1>
    <p class="lede">
      Herramientas IA is published in Spanish at the root of the site. English pages can live in
      <code>/en/</code> later, without moving the current URLs.
    </p>
    <div class="hero-actions">
      <a class="button" href="/">Leer en español</a>
    </div>
  </div>
</Base>
