---
import { render } from 'astro:content';
import EntryPage from '../../components/EntryPage.astro';
import { loadPublished, type GuideEntry } from '../../lib/content';
import { articleLd, breadcrumbLd, canonicalUrl, faqLd, isoDate } from '../../lib/seo';
import { SITE_URL } from '../../lib/site';

export async function getStaticPaths() {
  const items = await loadPublished('guias');
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: GuideEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const canonical = canonicalUrl(`/guias/${entry.id}`);
const published = isoDate(entry.data.updated);
const related = (await loadPublished('guias'))
  .filter((item) => item.id !== entry.id)
  .map((item) => ({ href: `/guias/${item.id}`, title: item.data.title }));
const faq = entry.data.faq ?? [];
const jsonLd = [
  articleLd({
    title: entry.data.title,
    description: entry.data.description,
    canonical,
    published,
    modified: published,
  }),
  faqLd(faq),
  breadcrumbLd([
    { name: 'Inicio', url: SITE_URL },
    { name: 'Guías', url: `${SITE_URL}/guias` },
    { name: entry.data.title, url: canonical },
  ]),
].filter(Boolean);
---

<EntryPage
  title={entry.data.title}
  description={entry.data.description}
  eyebrow="Guía"
  crumbs={[
    { label: 'Inicio', href: '/' },
    { label: 'Guías', href: '/guias' },
    { label: entry.data.title },
  ]}
  updated={entry.data.updated}
  ogType="article"
  published={published}
  modified={published}
  jsonLd={jsonLd}
  related={related}
  relatedTitle="Otras guías"
>
  <Content />
  {
    faq.length > 0 && (
      <section class="faq">
        <h2>Preguntas frecuentes</h2>
        {faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>
    )
  }
</EntryPage>
