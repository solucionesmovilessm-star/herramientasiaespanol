---
import NewsletterForm from '../components/NewsletterForm.astro';
import SponsorSlot from '../components/SponsorSlot.astro';
import Base from '../layouts/Base.astro';
import { newsletterName } from '../lib/catalog';
import { breadcrumbLd, canonicalUrl } from '../lib/seo';
import { SITE_URL } from '../lib/site';

const description =
  `Apúntate a ${newsletterName}. Un correo corto cuando haya una guía nueva o se actualice el ranking.`;
const pageUrl = canonicalUrl('/newsletter');
---

<Base
  title="Newsletter"
  description={description}
  jsonLd={breadcrumbLd([
    { name: 'Inicio', url: SITE_URL },
    { name: 'Newsletter', url: pageUrl },
  ])}
>
  <article class="narrow">
    <header class="page-intro">
      <p class="eyebrow">Avisos</p>
      <h1>{newsletterName}</h1>
      <p class="lede">
        La idea es un correo corto cuando haya una guía nueva o se actualice el ranking.
      </p>
    </header>
    <NewsletterForm submitLabel="Quiero que me avisen" />
    <div class="section">
      <SponsorSlot id="newsletter" />
    </div>
    <p class="fine">
      Un patrocinador de este hueco se edita en <code>src/data/patrocinios.json</code>. Si <code>activo</code> es false,
      se ve el espacio vacío, no un anuncio inventado.
    </p>
  </article>
</Base>
