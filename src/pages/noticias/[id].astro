---
import { render } from 'astro:content';
import EntryPage from '../../components/EntryPage.astro';
import { loadNews, resolveFicha, type NewsEntry } from '../../lib/content';
import { articleLd, breadcrumbLd, canonicalUrl, formatDate, isoDate } from '../../lib/seo';
import { SITE_URL } from '../../lib/site';

export async function getStaticPaths() {
  const items = await loadNews();
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: NewsEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const canonical = canonicalUrl(`/noticias/${entry.id}`);
const published = isoDate(entry.data.date);
const fichaHref = await resolveFicha(entry.data.ficha);
const related = (await loadNews())
  .filter((item) => item.id !== entry.id)
  .slice(0, 5)
  .map((item) => ({ href: `/noticias/${item.id}`, title: item.data.title }));
const hostOf = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
};
const jsonLd = [
  articleLd({
    title: entry.data.title,
    description: entry.data.summary,
    canonical,
    published,
    modified: published,
  }),
  breadcrumbLd([
    { name: 'Inicio', url: SITE_URL },
    { name: 'Noticias', url: `${SITE_URL}/noticias` },
    { name: entry.data.title, url: canonical },
  ]),
];
---

<EntryPage
  title={entry.data.title}
  description={entry.data.summary}
  eyebrow="Noticia"
  meta={formatDate(entry.data.date)}
  crumbs={[
    { label: 'Inicio', href: '/' },
    { label: 'Noticias', href: '/noticias' },
    { label: entry.data.title },
  ]}
  ogType="article"
  published={published}
  modified={published}
  jsonLd={jsonLd}
  related={related}
  relatedTitle="Otras noticias"
>
  <Content />
  {
    fichaHref && (
      <p>
        <a class="text-link" href={fichaHref}>Ver la ficha completa</a>
      </p>
    )
  }
  <section class="sources" aria-labelledby="fuentes">
    <h2 id="fuentes">Fuentes</h2>
    <ul>
      {
        entry.data.sources.map((url) => (
          <li>
            <a href={url} rel="noopener" target="_blank">{hostOf(url)}</a>
          </li>
        ))
      }
    </ul>
  </section>
</EntryPage>
