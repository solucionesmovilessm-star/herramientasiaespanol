---
import Directory from '../../components/Directory.astro';
import { loadPublished, moneyBadges } from '../../lib/content';
import { breadcrumbLd, canonicalUrl, itemListLd } from '../../lib/seo';
import { SITE_URL, skillCategories } from '../../lib/site';

const all = (await loadPublished('skills')).filter((entry) => entry.data.category === 'claude');
const title = 'Skills para Claude';
const pageUrl = canonicalUrl('/skills/claude');
const lede =
  'Carpetas de instrucciones que Claude puede cargar para tareas concretas. Estas fichas enlazan las que publica Anthropic. No son un pack de pago de este sitio.';
---

<Directory
  title={title}
  eyebrow={skillCategories.claude}
  lede={lede}
  metaDescription="Skills para Claude: ejemplos oficiales de Anthropic para PDF, Word, hojas de cálculo, presentaciones y otras tareas, con enlace al repositorio."
  items={all.map((entry) => ({
    href: `/skills/${entry.id}`,
    title: entry.data.title,
    description: entry.data.description,
    meta: 'Anthropic · repositorio oficial',
    badges: moneyBadges(entry.data),
  }))}
  countLabel="skills"
  jsonLd={[
    breadcrumbLd([
      { name: 'Inicio', url: SITE_URL },
      { name: 'Skills', url: `${SITE_URL}/skills` },
      { name: title, url: pageUrl },
    ]),
    itemListLd(
      title,
      all.map((entry) => ({ name: entry.data.title, url: `${SITE_URL}/skills/${entry.id}` })),
    ),
  ]}
>
  <p>
    Si partes de cero, sigue el tutorial <a href="/tutoriales/como-anadir-skills-a-claude">cómo añadir skills a Claude</a>.
    El formato común está explicado en <a href="/skills/estandar-agent-skills">Agent Skills</a>.
  </p>
</Directory>
