---
import { render } from 'astro:content';
import EntryPage from '../../components/EntryPage.astro';
import MoneyNotes from '../../components/MoneyNotes.astro';
import OfficialLinks from '../../components/OfficialLinks.astro';
import { loadPublished, moneyBadges, type SkillEntry } from '../../lib/content';
import { breadcrumbLd, canonicalUrl, isoDate } from '../../lib/seo';
import { SITE_URL, skillCategories } from '../../lib/site';

export async function getStaticPaths() {
  const items = await loadPublished('skills');
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: SkillEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const canonical = canonicalUrl(`/skills/${entry.id}`);
const published = isoDate(entry.data.updated);
const siblings = (await loadPublished('skills')).filter(
  (item) => item.id !== entry.id && item.data.category === entry.data.category,
);
const parent =
  entry.data.category === 'claude'
    ? { label: 'Skills para Claude', href: '/skills/claude', url: `${SITE_URL}/skills/claude` }
    : { label: 'Skills', href: '/skills', url: `${SITE_URL}/skills` };
---

<EntryPage
  title={entry.data.title}
  description={entry.data.description}
  eyebrow={skillCategories[entry.data.category]}
  crumbs={[
    { label: 'Inicio', href: '/' },
    { label: 'Skills', href: '/skills' },
    ...(entry.data.category === 'claude' ? [{ label: 'Skills para Claude', href: '/skills/claude' }] : []),
    { label: entry.data.title },
  ]}
  badges={moneyBadges(entry.data)}
  updated={entry.data.updated}
  published={published}
  modified={published}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'SoftwareSourceCode',
      name: entry.data.title,
      description: entry.data.description,
      url: new URL(entry.data.url, SITE_URL).href,
      codeRepository: new URL(entry.data.url, SITE_URL).href,
      inLanguage: 'es',
    },
    breadcrumbLd([
      { name: 'Inicio', url: SITE_URL },
      { name: 'Skills', url: `${SITE_URL}/skills` },
      ...(entry.data.category === 'claude' ? [{ name: parent.label, url: parent.url }] : []),
      { name: entry.data.title, url: canonical },
    ]),
  ]}
  related={siblings.slice(0, 4).map((item) => ({ href: `/skills/${item.id}`, title: item.data.title }))}
  relatedTitle="Otras skills"
>
  <OfficialLinks slot="actions" url={entry.data.url} affiliateUrl={entry.data.affiliateUrl} label="Abrir el repositorio o la documentación" />
  <MoneyNotes slot="notes" affiliateUrl={entry.data.affiliateUrl} patrocinado={entry.data.patrocinado} />
  {entry.data.video && (
    <figure class="skill-demo">
      <div class="skill-demo__frame">
        <span class="skill-demo__badge"><span class="skill-demo__dot"></span>Demo en vídeo</span>
        <video
          src={entry.data.video}
          poster={entry.data.videoPoster}
          autoplay
          muted
          loop
          playsinline
          controls
          preload="metadata"
          aria-label={`Vídeo de demostración: ${entry.data.title}`}
        ></video>
      </div>
      <figcaption>Míralo en acción · activa el sonido con los controles del vídeo.</figcaption>
    </figure>
  )}
  <Content />
</EntryPage>

<style>
  .skill-demo { margin: 0 auto 2.5rem; max-width: 420px; }
  .skill-demo__frame {
    position: relative; padding: 4px; border-radius: 26px;
    background: linear-gradient(135deg, #7c3aed, #06b6d4, #22c55e, #f59e0b, #7c3aed);
    background-size: 300% 300%; animation: skill-demo-glow 8s ease infinite;
    box-shadow: 0 20px 60px -15px rgba(124, 58, 237, 0.55), 0 0 40px -10px rgba(6, 182, 212, 0.5);
  }
  .skill-demo video {
    display: block; width: 100%; aspect-ratio: 9 / 16; object-fit: cover;
    border-radius: 22px; background: #000;
  }
  .skill-demo__badge {
    position: absolute; top: 14px; left: 14px; z-index: 2; display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 11px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.02em;
    color: #fff; background: rgba(0, 0, 0, 0.55); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    pointer-events: none;
  }
  .skill-demo__dot { width: 8px; height: 8px; border-radius: 50%; background: #ef4444; animation: skill-demo-pulse 1.6s ease-in-out infinite; }
  .skill-demo figcaption { margin-top: 0.75rem; text-align: center; font-size: 0.85rem; opacity: 0.75; }
  @keyframes skill-demo-glow { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
  @keyframes skill-demo-pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.8); } }
  @media (prefers-reduced-motion: reduce) { .skill-demo__frame, .skill-demo__dot { animation: none; } }
</style>
