---
import Directory from '../../components/Directory.astro';
import { loadHackeos, matchesQuery } from '../../lib/content';
import { breadcrumbLd, canonicalUrl, formatDate, itemListLd, pagePath } from '../../lib/seo';
import { nivelRiesgo } from '../../lib/site';

const all = await loadHackeos();
const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const filtered = all.filter((entry) =>
  matchesQuery([entry.data.title, entry.data.description, entry.data.riesgo], q),
);
const title = 'El hackeo del día';
const pageUrl = canonicalUrl('/hackeo-del-dia');
---

<Directory
  title={title}
  eyebrow="Seguridad"
  lede="Incidentes explicados en español: qué pasó, a quién afecta y qué hacer. La entrada más reciente va arriba. Cada una tiene una dirección fija para compartirla."
  metaDescription="El hackeo del día: incidentes de seguridad explicados en español, con fecha, nivel de riesgo, qué hacer y las fuentes."
  items={filtered.map((entry) => ({
    href: pagePath(`/hackeo-del-dia/${entry.id}`),
    title: entry.data.title,
    description: entry.data.description,
    meta: formatDate(entry.data.date),
    badges: [{ label: nivelRiesgo[entry.data.nivel], tone: entry.data.nivel }],
  }))}
  countLabel="entradas"
  query={q}
  searchAction={pagePath('/hackeo-del-dia')}
  jsonLd={q
    ? undefined
    : [
        breadcrumbLd([
          { name: 'Inicio', url: canonicalUrl('/') },
          { name: title, url: pageUrl },
        ]),
        itemListLd(
          title,
          all.map((entry) => ({
            name: entry.data.title,
            url: canonicalUrl(`/hackeo-del-dia/${entry.id}`),
          })),
        ),
      ]}
/>
