---
import type { Badge } from '../lib/content';
import Mark from './Mark.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  meta?: string;
  badges?: Badge[];
  heading?: 'h2' | 'h3';
  external?: boolean;
}

const { href, title, description, meta, badges = [], heading = 'h2', external = false } = Astro.props;
const Tag = heading;
---

<a
  class="card"
  data-reveal
  href={href}
  {...external ? { rel: 'noopener noreferrer', target: '_blank' } : {}}
>
  <span class="card-top">
    <Mark name={title} />
    {
      badges.length > 0 && (
        <span class="badge-row">
          {badges.map((badge) => (
            <span class:list={['badge', badge.tone]}>{badge.label}</span>
          ))}
        </span>
      )
    }
  </span>
  <Tag>{title}</Tag>
  <p>{description}</p>
  {meta && <p class="meta">{meta}</p>}
</a>
