---
import type { Badge } from '../lib/content';
import { formatDate } from '../lib/seo';
import Breadcrumbs from './Breadcrumbs.astro';
import Mark from './Mark.astro';
import Base from '../layouts/Base.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Related {
  href: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  crumbs: Crumb[];
  badges?: Badge[];
  meta?: string;
  updated?: Date;
  jsonLd?: unknown;
  ogType?: 'website' | 'article';
  image?: string;
  notice?: string;
  noticeLabel?: string;
  risk?: { nivel: 'bajo' | 'medio' | 'alto' | 'critico'; label: string; text: string };
  mark?: 'letters' | 'alerta';
  published?: string;
  modified?: string;
  tutorial?: boolean;
  related?: Related[];
  relatedTitle?: string;
}

const {
  title,
  description,
  eyebrow,
  crumbs,
  badges = [],
  meta,
  updated,
  jsonLd,
  ogType = 'website',
  image,
  notice,
  noticeLabel,
  risk,
  mark = 'letters',
  published,
  modified,
  tutorial = false,
  related = [],
  relatedTitle = 'También en esta sección',
} = Astro.props;
---

<Base
  title={title}
  description={description}
  jsonLd={jsonLd}
  ogType={ogType}
  image={image}
  published={published}
  modified={modified}
>
  <article class="narrow entry">
    <Breadcrumbs items={crumbs} />
    <header class="article-head glass">
      <div class="entry-top">
        {
          mark === 'alerta' ? (
            <span class:list={['entry-alert', risk?.nivel ?? 'alto']} aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3.2 19.2 6v5.6c0 4.4-3 7.6-7.2 9.2C7.8 19.2 4.8 16 4.8 11.6V6z"></path>
                <path d="M12 8.2v4.3"></path>
                <path d="M12 15.4h.01"></path>
              </svg>
            </span>
          ) : (
            <Mark name={title} large />
          )
        }
        <div>
          <p class="eyebrow">{eyebrow}</p>
          <h1>{title}</h1>
        </div>
      </div>
      <p class="lede">{description}</p>
      {
        badges.length > 0 && (
          <div class="badge-row">
            {badges.map((badge) => (
              <span class:list={['badge', badge.tone]}>{badge.label}</span>
            ))}
          </div>
        )
      }
      {meta && <p class="meta">{meta}</p>}
      {
        updated && (
          <p class="meta">
            Actualizado el <time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated)}</time>
          </p>
        )
      }
      {
        risk && (
          <div class="risk-panel">
            <p class="risk-heading">
              <span>Nivel de riesgo</span>
              <span class:list={['risk-tag', risk.nivel]}>{risk.label}</span>
            </p>
            <p>{risk.text}</p>
          </div>
        )
      }
      {
        !risk && notice && (
          <p class="callout warn">
            {noticeLabel && <strong>{noticeLabel}. </strong>}
            {notice}
          </p>
        )
      }
      <div class="actions">
        <slot name="actions" />
      </div>
      <slot name="notes" />
    </header>
    <div class:list={['prose', { tutorial }]}>
      <slot />
    </div>
    {
      related.length > 0 && (
        <aside class="related">
          <h2>{relatedTitle}</h2>
          <ul>
            {related.map((item) => (
              <li>
                <a href={item.href}>{item.title}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </article>
</Base>
