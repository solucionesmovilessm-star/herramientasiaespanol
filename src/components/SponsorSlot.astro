---
import { getSponsor, sponsorLabels, type SponsorId } from '../lib/sponsors';

interface Props {
  id: SponsorId;
}

const { id } = Astro.props;
const slot = getSponsor(id);
const label = sponsorLabels[id];
---

{
  slot.ready ? (
    <aside class="sponsor" aria-label="Contenido patrocinado">
      <div class="badge-row">
        <span class="badge paid">Patrocinado</span>
      </div>
      <h2>
        <a href={slot.url} rel="sponsored noopener noreferrer">
          {slot.patrocinador}
        </a>
      </h2>
      <p>{slot.texto}</p>
      {slot.hasta && <p class="meta">Hasta {slot.hasta}</p>}
    </aside>
  ) : slot.broken ? (
    <aside class="sponsor sponsor-empty">
      <p>
        El hueco de patrocinio de {label} está marcado como activo, pero falta el nombre, el texto o un enlace https.
        Revisa <code>src/data/patrocinios.json</code>.
      </p>
    </aside>
  ) : (
    <aside class="sponsor sponsor-empty">
      <p>
        Espacio para un patrocinador de {label}. Se mostrará con la etiqueta Patrocinado.{' '}
        <a href="/patrocina">Patrocina</a>.
      </p>
    </aside>
  )
}
