---
import { useTranslations } from '../i18n/ui';
import { isActive, moreNav, nav } from '../lib/site';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/">
      <span class="mark" aria-hidden="true">hí</span>
      <span>
        <strong>Herramientas IA</strong>
        <small>en español</small>
      </span>
    </a>
    <nav class="nav-desktop" aria-label="Secciones">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href, path) ? 'page' : undefined}>
            {t(item.key)}
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <button
        class="cmdk-trigger"
        type="button"
        data-cmdk-open
        aria-haspopup="dialog"
        aria-controls="cmdk"
        aria-keyshortcuts="Control+K Meta+K"
        aria-label={t('search.open')}
      >
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <circle cx="11" cy="11" r="6"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="cmdk-trigger-label">{t('search.label')}</span>
        <kbd>Ctrl</kbd>
        <kbd>K</kbd>
      </button>
      <a class="button small" href="/pro">{t('nav.pro')}</a>
      <button
        id="theme-toggle"
        class="icon-btn"
        type="button"
        aria-pressed="false"
        data-label-dark={t('theme.toDark')}
        data-label-light={t('theme.toLight')}
      >
        <span aria-hidden="true">◐</span>
      </button>
      <details class="nav-mobile">
        <summary>{t('menu')}</summary>
        <nav class="nav-panel" aria-label="Secciones">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isActive(item.href, path) ? 'page' : undefined}>
                {t(item.key)}
              </a>
            ))
          }
          <a href="/patrocina">{t('nav.advertise')}</a>
          <a href="/sobre">{t('nav.about')}</a>
          <a href="/pro">{t('nav.pro')}</a>
          {
            moreNav.map((item) => (
              <a href={item.href} aria-current={isActive(item.href, path) ? 'page' : undefined}>
                {t(item.key)}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
