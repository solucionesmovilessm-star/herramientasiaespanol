---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Migas de pan">
  <ol class="crumbs">
    {
      items.map((item, index) => (
        <li>
          {index > 0 && <span aria-hidden="true"> / </span>}
          {item.href && index < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>
